package loader
import os
import io

pub func Load(path: str, opened &: bool): Vector<str>:
    mut out := Vector {} as Vector<str>
    opened = false
    if os.IsDir(path): ret out end
    handle := os.Open(path, "rb")
    if handle == null: ret out end
    mut text := io.ReadAll(handle)
    io.Close(handle)
    opened = true
    // The literal below is U+FEFF, encoded as the three UTF-8 BOM bytes.
    if text.len() >= 3 and text.substr(0, 3) == "﻿":
        text = text.substr(3, text.len() - 3)
    end
    if text.len() == 0: ret out end
    mut raw := text.split("\n")
    defer raw.free()
    repeat raw.len() in i:
        line := raw.get(i)
        if i == raw.len() - 1 and line.len() == 0: break end
        if line.len() > 0 and line.substr(line.len() - 1, 1) == "\r":
            out.push(line.substr(0, line.len() - 1))
        else:
            out.push(line)
        end
    end
    ret out
end
