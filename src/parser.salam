package parser
include card "card.salam"
include normalizer "normalizer.salam"

pub func Ignored(line: str): bool:
    trimmed := normalizer.Trim(line)
    // A whitespace-only TSV row still contains real (blank) card fields.
    if trimmed.len() == 0: ret line.find("\t") < 0 end
    ret trimmed.substr(0, 1) == "#"
end

pub func Parse(lines: Vector<str>): Vector<card.Card>:
    mut cards := Vector {} as Vector<card.Card>
    repeat lines.len() in i:
        raw := lines.get(i)
        if not Ignored(raw):
            mut fields := raw.split("\t")
            defer fields.free()
            mut item := card.Card { line = i + 1, columns = fields.len() }
            if fields.len() == 3:
                item.question = normalizer.Trim(fields.get(0))
                item.answer = normalizer.Trim(fields.get(1))
                item.topic = normalizer.Trim(fields.get(2))
            end
            cards.push(item)
        end
    end
    ret cards
end
