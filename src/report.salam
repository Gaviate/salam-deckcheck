package report
include summary "summary.salam"
include topics "topics.salam"

pub func Print(counts: summary.Counts, physical_lines: int):
    println "Cards: ", counts.rows
    println "Ignored lines: ", physical_lines - counts.rows
    println "Complete cards: ", counts.valid
    println "Unique complete cards: ", counts.valid - counts.duplicates
    println "Malformed rows: ", counts.malformed
    println "Blank questions: ", counts.blank_questions
    println "Blank answers: ", counts.blank_answers
    println "Duplicate questions: ", counts.duplicates
    println "Errors: ", counts.errors
    if summary.Passed(counts):
        println "Result: PASS"
    else:
        println "Result: FAIL"
    end
end

pub func TopicCoverage(rows: Vector<topics.Topic>):
    println "Topics (unique complete cards): ", rows.len()
    repeat rows.len() in i:
        row := rows.get(i)
        if row.unnamed:
            println "  No topic: ", row.cards
        else:
            println "  Topic \"", row.name, "\": ", row.cards
        end
    end
end
