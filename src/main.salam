import os
include cli "cli.salam"
include loader "loader.salam"
include parser "parser.salam"
include validator "validator.salam"
include report "report.salam"
include summary "summary.salam"
include duplicates "duplicates.salam"
include topics "topics.salam"

func main:
    mut argv := os.Args()
    defer argv.free()
    if argv.len() == 1:
        cli.Help()
        ret 0
    end
    if argv.len() != 2:
        println "error: provide exactly one TSV deck path"
        ret 2
    end
    if argv.get(1) == "--help":
        cli.Help()
        ret 0
    end
    path := argv.get(1)
    mut opened := false
    mut lines := loader.Load(path, opened)
    defer lines.free()
    if not opened:
        println "error: cannot read deck: ", path
        ret 2
    end
    println "Deck: ", path
    mut cards := parser.Parse(lines)
    defer cards.free()
    mut counts := validator.Check(cards)
    counts.duplicates = duplicates.Check(cards)
    counts.errors += counts.duplicates
    report.Print(counts, lines.len())
    mut coverage := topics.Count(cards)
    defer coverage.free()
    report.TopicCoverage(coverage)
    if summary.Passed(counts): ret 0 end
    ret 1
end
